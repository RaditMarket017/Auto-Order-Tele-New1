{
  "version": 2,
  "buildCommand": "npm run build",
  "outputDirectory": "bot-server/admin-app/dist",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/admin/(.*)", "destination": "/api/index.js" },
    { "source": "/admin", "destination": "/api/index.js" },
    { "source": "/", "destination": "/api/index.js" }
  ]
}
