<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>Shop Mini App</title>
  <script src="https://telegram.org/js/telegram-web-app.js"></script>
  <script src="https://cdn.tailwindcss.com"></script>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fira+Code:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
  <script>
    tailwind.config = {
      theme: {
        extend: {
          fontFamily: {
            sans: ['"Plus Jakarta Sans"', 'system-ui', 'sans-serif'],
            mono: ['"Fira Code"', 'monospace'],
          },
          colors: {
            brand: { 500: '#38bdf8', 600: '#0284c7' }
          }
        }
      }
    }
  </script>
  <style>
    * { -webkit-tap-highlight-color: transparent; }
    /* Hide scrollbar for Chrome, Safari and Opera */
    .no-scrollbar::-webkit-scrollbar { display: none; width: 0; height: 0; }
    .no-scrollbar { -ms-overflow-style: none; scrollbar-width: none; }
  </style>
</head>
<body class="bg-[#030712] text-slate-100 font-sans min-h-screen pb-12 antialiased selection:bg-sky-500 selection:text-white bg-[radial-gradient(ellipse_at_top,_var(--tw-gradient-stops))] from-sky-950/20 via-slate-950 to-slate-950">

  <!-- Sticky Glass Header Ultra Pro Max -->
  <header class="sticky top-0 z-40 bg-slate-950/85 backdrop-blur-xl border-b border-slate-800/80 px-4 py-3 flex items-center justify-between gap-3 shadow-lg shadow-black/40">
    <div class="flex items-center gap-3">
      <div class="relative">
        <img id="logoImg" src="https://i.pinimg.com/236x/a5/33/fb/a533fba7aa6d6eedf05f49804e6da478.jpg" class="w-10 h-10 rounded-2xl object-cover border border-sky-500/30 shadow-md shadow-sky-500/10">
        <span class="absolute -bottom-0.5 -right-0.5 w-3 h-3 bg-emerald-500 border-2 border-slate-950 rounded-full"></span>
      </div>
      <div>
        <h1 id="storeTitle" class="text-sm font-extrabold text-white tracking-tight">PanzzStore</h1>
        <p class="text-[10px] text-sky-400 font-bold flex items-center gap-1">
          <svg class="w-3 h-3" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          Verified Official Store
        </p>
      </div>
    </div>

    <!-- User Profile Badge -->
    <div class="flex items-center gap-2">
      <div class="bg-slate-900/90 border border-slate-800 px-3 py-1.5 rounded-2xl flex items-center gap-2 text-xs font-semibold shadow-md">
        <div id="userAvatarBox" class="w-7 h-7 rounded-xl bg-sky-500/20 text-sky-400 border border-sky-500/30 flex items-center justify-center font-extrabold text-xs shrink-0">
          U
        </div>
        <div class="flex flex-col text-left">
          <span id="userFirstName" class="text-[11px] font-extrabold text-white leading-tight">Member</span>
          <span id="userBalanceText" class="text-[9px] text-emerald-400 font-extrabold">Rp 0</span>
        </div>
      </div>
    </div>
  </header>

  <main class="max-w-xl mx-auto p-4 space-y-4">
    
    <!-- Announcement Banner -->
    <div class="relative overflow-hidden bg-gradient-to-r from-sky-900/40 via-indigo-900/40 to-slate-900/80 border border-sky-500/20 rounded-3xl p-4 shadow-xl">
      <div class="relative z-10 flex items-center gap-3">
        <div class="w-10 h-10 rounded-2xl bg-sky-500/20 border border-sky-500/30 flex items-center justify-center text-sky-400 shrink-0 shadow-inner">
          ⚡
        </div>
        <div>
          <h3 class="text-xs font-extrabold text-white">Auto Delivery 24/7 Active</h3>
          <p class="text-[10px] text-slate-300 mt-0.5">Seluruh produk dikirim otomatis detik itu juga setelah bayar.</p>
        </div>
      </div>
      <div class="absolute -right-6 -bottom-6 w-24 h-24 bg-sky-500/10 rounded-full blur-xl pointer-events-none"></div>
    </div>

    <!-- Search Bar & Filters -->
    <div class="space-y-2">
      <div class="relative">
        <svg class="absolute left-3.5 top-1/2 -translate-y-1/2 w-4 h-4 text-slate-400" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
        <input type="text" id="searchInput" oninput="filterProducts()" placeholder="Cari produk digital..." class="w-full bg-slate-900/90 border border-slate-800 rounded-2xl pl-10 pr-4 py-2.5 text-xs text-white placeholder-slate-500 focus:outline-none focus:border-sky-500 focus:ring-1 focus:ring-sky-500 transition-all">
      </div>

      <!-- Quick Category Pills -->
      <div class="flex items-center gap-1.5 overflow-x-auto no-scrollbar pt-1">
        <button onclick="filterCategory('all')" class="cat-pill active px-3 py-1 rounded-xl text-[11px] font-bold bg-sky-500 text-white transition-all">Semua</button>
        <button onclick="filterCategory('instant')" class="cat-pill px-3 py-1 rounded-xl text-[11px] font-bold bg-slate-900 border border-slate-800 text-slate-400 hover:text-white transition-all">⚡ Instan</button>
        <button onclick="filterCategory('popular')" class="cat-pill px-3 py-1 rounded-xl text-[11px] font-bold bg-slate-900 border border-slate-800 text-slate-400 hover:text-white transition-all">🔥 Populer</button>
      </div>
    </div>

    <!-- Section Title -->
    <div class="flex items-center justify-between text-xs font-extrabold text-slate-300 tracking-tight pt-1">
      <span class="flex items-center gap-1.5">
        📦 KATALOG PRODUK
      </span>
      <span id="productCount" class="text-sky-400 font-mono text-[11px]">0 Produk</span>
    </div>

    <!-- Product Grid -->
    <div id="productGrid" class="grid grid-cols-2 gap-3 sm:grid-cols-3">
      <p class="col-span-full text-center py-10 text-slate-500 text-sm">Memuat katalog produk...</p>
    </div>

  </main>

  <!-- Bottom Sheet Checkout Modal (UI/UX Pro Max Step Flow) -->
  <div id="checkoutSheet" class="hidden fixed inset-0 z-50 bg-black/80 backdrop-blur-md flex items-end justify-center p-0 sm:p-4">
    <div class="w-full max-w-lg bg-slate-900 border-t sm:border border-slate-800 rounded-t-3xl sm:rounded-2xl p-5 max-h-[90vh] overflow-y-auto space-y-4 animate-in slide-in-from-bottom duration-200">
      <div class="w-10 h-1 bg-slate-800 rounded-full mx-auto"></div>
      
      <div>
        <h3 id="modalName" class="text-lg font-extrabold text-white">Nama Produk</h3>
        <p id="modalDesc" class="text-xs text-slate-400 mt-1">Deskripsi singkat produk</p>
      </div>

      <!-- Wholesale Tiers Info Banner -->
      <div id="wholesaleBanner" class="hidden bg-amber-500/10 border border-amber-500/30 rounded-2xl p-3 space-y-1.5">
        <span class="text-[11px] font-extrabold text-amber-400 flex items-center gap-1.5">
          🏷️ HARGA GROSIR DISKON BULK:
        </span>
        <div id="wholesaleTierBadges" class="flex items-center gap-1.5 overflow-x-auto no-scrollbar pt-0.5"></div>
      </div>

      <!-- Step 1: Pilih Varian -->
      <div class="space-y-2">
        <label class="text-[11px] font-extrabold text-slate-400 uppercase tracking-wider">1. PILIH PAKET / VARIAN</label>
        <div id="variantList" class="space-y-2"></div>
      </div>

      <!-- Step 2: Jumlah Beli (Qty Selector) -->
      <div class="space-y-2">
        <label class="text-[11px] font-extrabold text-slate-400 uppercase tracking-wider">2. JUMLAH PEMBELIAN (QTY)</label>
        <div class="bg-slate-950 border border-slate-800 rounded-2xl p-3.5 space-y-3">
          <div class="flex items-center justify-between">
            <span class="text-xs font-semibold text-slate-300">Jumlah Beli:</span>
            <div class="flex items-center gap-3">
              <button type="button" onclick="adjustQty(-1)" class="w-9 h-9 rounded-xl bg-slate-800 hover:bg-slate-700 text-white font-bold text-base flex items-center justify-center border border-slate-700 active:scale-95 transition-all">−</button>
              <span id="qtyDisplay" class="text-base font-extrabold text-white min-w-[28px] text-center font-mono">1</span>
              <button type="button" onclick="adjustQty(1)" class="w-9 h-9 rounded-xl bg-sky-500 hover:bg-sky-400 text-white font-bold text-base flex items-center justify-center shadow-lg shadow-sky-500/20 active:scale-95 transition-all">+</button>
            </div>
          </div>

          <!-- Quick Presets -->
          <div class="flex items-center gap-1.5 pt-0.5">
            <button type="button" onclick="setQuickQty(1)" class="flex-1 py-1 bg-slate-900 border border-slate-800 text-slate-300 hover:text-white rounded-lg text-[10px] font-bold transition-all">+1 pcs</button>
            <button type="button" onclick="setQuickQty(5)" class="flex-1 py-1 bg-slate-900 border border-slate-800 text-slate-300 hover:text-white rounded-lg text-[10px] font-bold transition-all">+5 pcs</button>
            <button type="button" onclick="setQuickQty(10)" class="flex-1 py-1 bg-slate-900 border border-slate-800 text-slate-300 hover:text-white rounded-lg text-[10px] font-bold transition-all">+10 pcs</button>
            <button type="button" onclick="setQuickQty(20)" class="flex-1 py-1 bg-slate-900 border border-slate-800 text-slate-300 hover:text-white rounded-lg text-[10px] font-bold transition-all">+20 pcs</button>
          </div>

          <div id="wholesaleNotice" class="hidden text-[10px] font-extrabold text-emerald-400 text-center">
            ✨ Diskon Grosir Aktif!
          </div>
        </div>
      </div>

      <!-- Step 3: Voucher Promo (Opsional) -->
      <div class="space-y-2">
        <label class="text-[11px] font-extrabold text-slate-400 uppercase tracking-wider">3. VOUCHER PROMO (OPSIONAL)</label>
        <div class="flex items-center gap-2">
          <input type="text" id="voucherInput" placeholder="Kode Voucher (ex: HEMAT50)" class="flex-1 uppercase font-bold bg-slate-950 border border-slate-800 rounded-xl px-3.5 py-2 text-xs text-white placeholder-slate-600 focus:border-sky-500 focus:outline-none">
          <button type="button" onclick="applyVoucherWeb()" class="px-4 py-2 bg-sky-500 hover:bg-sky-400 text-white font-extrabold text-xs rounded-xl shadow-lg shadow-sky-500/20 transition-all">Pakai</button>
        </div>
      </div>

      <!-- Step 4: Metode Pembayaran -->
      <div class="space-y-2">
        <label class="text-[11px] font-extrabold text-slate-400 uppercase tracking-wider">4. METODE PEMBAYARAN</label>
        <div class="grid grid-cols-2 gap-2">
          <button id="payCardQRIS" onclick="setPaymentMethod('qris')" class="p-3 bg-slate-950 border border-sky-500 bg-sky-500/10 rounded-xl flex items-center gap-3 text-left transition-all">
            <svg class="w-5 h-5 text-sky-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="5" height="5" x="3" y="3" rx="1"/><rect width="5" height="5" x="16" y="3" rx="1"/><rect width="5" height="5" x="3" y="16" rx="1"/><path d="M21 16h-3a2 2 0 0 0-2 2v3"/><path d="M21 21v.01"/><path d="M12 7v3a2 2 0 0 1-2 2H7"/><path d="M3 12h.01"/><path d="M12 3h.01"/><path d="M12 16v.01"/><path d="M16 12h1"/><path d="M21 12v.01"/><path d="M12 21v-1"/></svg>
            <div>
              <div class="text-xs font-bold text-white">QRIS Instan</div>
              <div class="text-[10px] text-slate-400">All E-Wallet / Bank</div>
            </div>
          </button>

          <button id="payCardSaldo" onclick="setPaymentMethod('saldo')" class="p-3 bg-slate-950 border border-slate-800 rounded-xl flex items-center gap-3 text-left transition-all opacity-70">
            <svg class="w-5 h-5 text-slate-400 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="20" height="14" x="2" y="5" rx="2"/><line x1="2" x2="22" y1="10" y2="10"/></svg>
            <div>
              <div class="text-xs font-bold text-white">Saldo Bot</div>
              <div id="saldoTextSub" class="text-[10px] text-emerald-400 font-extrabold">Saldo: Rp 0</div>
            </div>
          </button>
        </div>
      </div>

      <!-- Step 5: Summary Card & Pay Button -->
      <div class="bg-slate-950 border border-slate-800 rounded-2xl p-3.5 space-y-1.5 text-xs">
        <div class="flex justify-between text-slate-400">
          <span>Harga Satuan:</span>
          <span id="summaryUnitPriceText" class="font-semibold text-slate-200">Rp 0</span>
        </div>
        <div class="flex justify-between text-slate-400">
          <span>Jumlah (Qty):</span>
          <span id="summaryQtyText" class="font-semibold text-slate-200">1 pcs</span>
        </div>
        <div id="summaryVoucherRow" class="hidden flex justify-between text-emerald-400 font-bold">
          <span>Diskon Voucher:</span>
          <span id="summaryVoucherText">-Rp 0</span>
        </div>
        <div class="border-t border-slate-800 pt-2 flex justify-between font-extrabold text-sm text-white">
          <span>TOTAL TAGIHAN:</span>
          <span id="summaryTotalText" class="text-sky-400 font-mono text-base">Rp 0</span>
        </div>
      </div>

      <div class="pt-1 space-y-2">
        <button onclick="submitOrder()" class="w-full py-3.5 bg-gradient-to-r from-sky-500 to-sky-600 hover:from-sky-400 hover:to-sky-500 text-white font-black text-sm rounded-xl shadow-lg shadow-sky-500/25 transition-all flex items-center justify-center gap-2">
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4Z"/><line x1="3" x2="21" y1="6" y2="6"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>
          Bayar Sekarang
        </button>
        <button onclick="closeSheet()" class="w-full py-2 bg-slate-800 hover:bg-slate-700 text-slate-400 font-semibold text-xs rounded-xl transition-all">Batal</button>
      </div>
    </div>
  </div>

  <!-- Bottom Sheet Result Modal (UI/UX Pro Max Payment Check & Cancel) -->
  <div id="resultSheet" class="hidden fixed inset-0 z-50 bg-black/80 backdrop-blur-md flex items-end justify-center p-0 sm:p-4">
    <div class="w-full max-w-lg bg-slate-900 border-t sm:border border-slate-800 rounded-t-3xl sm:rounded-2xl p-6 text-center space-y-4 animate-in slide-in-from-bottom duration-200">
      <div class="w-10 h-1 bg-slate-800 rounded-full mx-auto"></div>
      <div id="resultContent"></div>
    </div>
  </div>

  <script>
    const urlParams = new URLSearchParams(window.location.search);
    const tg = window.Telegram?.WebApp;
    if (tg) { tg.ready(); tg.expand(); }

    const tgUser = tg?.initDataUnsafe?.user;
    const urlUserId = urlParams.get('user_id');
    const urlName = urlParams.get('name') || urlParams.get('first_name') || urlParams.get('username');

    const user = {
      id: tgUser?.id || urlUserId || '5665721422',
      first_name: tgUser?.first_name || urlName || (tgUser?.username ? '@' + tgUser.username : 'Member PanzzStore')
    };

    let allProducts = [];
    let selectedProduct = null;
    let selectedVariantIdx = 0;
    let paymentMethod = 'qris';
    let currentQty = 1;
    let appliedVoucherCode = '';
    let appliedVoucherDiscount = 0;
    let userBalance = 0;

    async function initApp() {
      try {
        const [infoRes, prodRes, userRes] = await Promise.all([
          fetch('/api/shop/store-info').then(r => r.json()),
          fetch('/api/shop/products').then(r => r.json()),
          fetch(`/api/shop/user-profile?user_id=${user.id}`).then(r => r.json()).catch(() => ({})),
        ]);

        if (userRes && userRes.success && userRes.data) {
          const uData = userRes.data;
          userBalance = uData.balance || 0;
          const displayName = tgUser?.first_name || (uData.name !== 'Member PanzzStore' ? uData.name : null) || urlName || 'Member PanzzStore';
          user.first_name = displayName;
          document.getElementById('userFirstName').innerText = displayName;
          document.getElementById('userBalanceText').innerText = 'Saldo: Rp ' + userBalance.toLocaleString('id-ID');
          document.getElementById('saldoTextSub').innerText = 'Saldo: Rp ' + userBalance.toLocaleString('id-ID');
          document.getElementById('userAvatarBox').innerText = displayName.charAt(0).toUpperCase();
        } else {
          const displayName = user.first_name || 'Member PanzzStore';
          document.getElementById('userFirstName').innerText = displayName;
          document.getElementById('userAvatarBox').innerText = displayName.charAt(0).toUpperCase();
        }

        let isMaintenanceMode = false;
        let maintenanceMessage = '';

        if (infoRes.success) {
          document.getElementById('storeTitle').innerText = infoRes.data.storeName || 'PanzzStore';
          if (infoRes.data.storeLogoUrl) {
            document.getElementById('logoImg').src = infoRes.data.storeLogoUrl;
          }
          if (infoRes.data.maintenanceMode) {
            isMaintenanceMode = true;
            maintenanceMessage = infoRes.data.maintenanceMessage || 'Toko sedang dalam pemeliharaan berkala.';
            showMaintenanceBanner(maintenanceMessage);
          }
        }

        if (prodRes.success && prodRes.data.length > 0) {
          allProducts = prodRes.data;
          renderProducts(allProducts);
        } else {
          document.getElementById('productGrid').innerHTML = '<p class="col-span-full text-center py-10 text-slate-500 text-sm">Belum ada produk tersedia.</p>';
        }
      } catch (err) {
        console.error(err);
        document.getElementById('productGrid').innerHTML = '<p class="col-span-full text-center py-10 text-slate-500 text-sm">Gagal terhubung ke katalog.</p>';
      }
    }

    function renderProducts(products) {
      document.getElementById('productCount').innerText = `${products.length} Produk`;
      const container = document.getElementById('productGrid');
      
      if(products.length === 0) {
        container.innerHTML = '<p class="col-span-full text-center py-10 text-slate-500 text-sm">Produk tidak ditemukan.</p>';
        return;
      }

      container.innerHTML = products.map(p => {
        const imgUrl = p.imageUrl || p.apkLogoUrl;
        const stockCount = p.stock || 0;
        const isReady = stockCount > 0;
        const isEmailInvite = Boolean(p.requiresEmail);

        return `
          <div onclick='openCheckout(${JSON.stringify(p).replace(/'/g, "&apos;")})' class="group relative bg-slate-900/90 border border-slate-800/90 hover:border-sky-500/50 rounded-2xl overflow-hidden cursor-pointer transition-all duration-300 hover:scale-[1.02] active:scale-[0.98] shadow-xl flex flex-col justify-between backdrop-blur-md">
            
            <!-- Image Banner Box 100% Full Cover -->
            <div class="relative w-full aspect-[4/5] bg-slate-950 overflow-hidden">
              ${imgUrl ? `
                <img src="${imgUrl}" alt="${p.name}" onerror="this.onerror=null; this.parentElement.innerHTML='<div class=\'w-full h-full bg-slate-900 flex items-center justify-center text-slate-400 font-extrabold text-2xl\'>${(p.name || 'P').charAt(0).toUpperCase()}</div>';" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500">
              ` : `
                <div class="w-full h-full bg-gradient-to-br from-sky-900/30 via-slate-900 to-slate-950 flex items-center justify-center text-sky-400 font-extrabold text-3xl shadow-inner">
                  ${(p.name || 'P').charAt(0).toUpperCase()}
                </div>
              `}

              <!-- Bottom Dark Gradient Overlay -->
              <div class="absolute inset-x-0 bottom-0 h-20 bg-gradient-to-t from-slate-950 via-slate-950/70 to-transparent z-10"></div>

              <!-- Floating Tersedia / Email Invite Badge (Bottom-Left) -->
              <div class="absolute bottom-2.5 left-2.5 z-20">
                <span class="px-2.5 py-1 rounded-xl text-[10px] font-extrabold shadow-lg backdrop-blur-md border ${ isReady ? (isEmailInvite ? 'bg-sky-500/90 text-white border-sky-400/40' : 'bg-emerald-500/90 text-white border-emerald-400/40') : 'bg-rose-500/90 text-white border-rose-400/40' } flex items-center gap-1.5 font-mono">
                  <span class="w-1.5 h-1.5 rounded-full ${ isReady ? 'bg-white animate-pulse' : 'bg-white/80' }"></span>
                  ${ isEmailInvite ? `INVITE • ${stockCount} Pcs` : (isReady ? `STOK ${stockCount}` : 'HABIS') }
                </span>
              </div>
            </div>

            <!-- Product Title & Price Footer -->
            <div class="p-3 bg-slate-950/90 text-center space-y-1 border-t border-slate-800/80">
              <h4 class="font-extrabold text-xs sm:text-sm text-white group-hover:text-sky-400 transition-colors line-clamp-1">${p.name}</h4>
              <p class="text-xs font-extrabold text-sky-400 font-mono">Rp ${(p.basePrice || p.variants?.[0]?.price || 0).toLocaleString('id-ID')}</p>
            </div>

          </div>
        `;
      }).join('');
    }

    function filterProducts() {
      const q = document.getElementById('searchInput').value.toLowerCase();
      const filtered = allProducts.filter(p => p.name.toLowerCase().includes(q) || (p.description || '').toLowerCase().includes(q));
      renderProducts(filtered);
    }

    function filterCategory(cat) {
      document.querySelectorAll('.cat-pill').forEach(btn => {
        btn.className = 'cat-pill px-3 py-1 rounded-xl text-[11px] font-bold bg-slate-900 border border-slate-800 text-slate-400 hover:text-white transition-all';
      });

      if (event && event.target) {
        event.target.className = 'cat-pill active px-3 py-1 rounded-xl text-[11px] font-bold bg-sky-500 text-white transition-all';
      }

      if (cat === 'all') {
        renderProducts(allProducts);
      } else if (cat === 'instant') {
        const filtered = allProducts.filter(p => (p.deliveryType || 'instant') === 'instant');
        renderProducts(filtered);
      } else if (cat === 'popular') {
        const filtered = [...allProducts].sort((a, b) => (b.stock || 0) - (a.stock || 0));
        renderProducts(filtered);
      }
    }

    let isMaintenanceActive = false;
    let currentMaintenanceMsg = '';

    function showMaintenanceBanner(msg) {
      isMaintenanceActive = true;
      currentMaintenanceMsg = msg;
      const banner = document.createElement('div');
      banner.className = 'bg-rose-500/15 border border-rose-500/30 rounded-2xl p-3.5 text-center text-rose-300 space-y-1 mb-3 animate-pulse';
      banner.innerHTML = `
        <div class="font-extrabold text-xs text-rose-400 flex items-center justify-center gap-1.5">
          ⚠️ TOKO SEDANG MAINTENANCE
        </div>
        <p class="text-[11px] text-slate-300 font-semibold">${msg}</p>
      `;
      const main = document.querySelector('main');
      if (main) main.insertBefore(banner, main.firstChild);
    }

    function openCheckout(product) {
      if (isMaintenanceActive) {
        return alert(`⚠️ TOKO SEDANG MAINTENANCE\n${currentMaintenanceMsg || 'Toko sedang dalam pemeliharaan berkala.'}`);
      }
      selectedProduct = product;
      selectedVariantIdx = 0;
      paymentMethod = 'qris';
      currentQty = 1;
      appliedVoucherCode = '';
      appliedVoucherDiscount = 0;
      document.getElementById('voucherInput').value = '';
      document.getElementById('summaryVoucherRow').classList.add('hidden');

      const imgUrl = product.imageUrl || product.apkLogoUrl;
      const modalNameEl = document.getElementById('modalName');
      
      if (imgUrl) {
        modalNameEl.innerHTML = `
          <div class="flex items-center gap-3 mb-1">
            <img src="${imgUrl}" class="w-10 h-10 rounded-xl object-cover border border-slate-800">
            <div>
              <h3 class="text-base font-extrabold text-white text-left leading-tight">${product.name}</h3>
              <p class="text-[10px] text-emerald-400 font-bold text-left">⚡ Processed Instantly</p>
            </div>
          </div>
        `;
      } else {
        modalNameEl.innerText = product.name;
      }

      document.getElementById('modalDesc').innerText = product.description || 'Produk digital instant & garansi penuh.';

      // Wholesale tiers info
      const wBanner = document.getElementById('wholesaleBanner');
      const wBadges = document.getElementById('wholesaleTierBadges');
      if (product.wholesaleTiers && product.wholesaleTiers.length > 0) {
        wBadges.innerHTML = product.wholesaleTiers.map(t => `
          <span class="px-2.5 py-1 rounded-xl bg-amber-500/20 text-amber-300 text-[10px] font-extrabold border border-amber-500/30 shrink-0">
            Min ${t.minQty} pcs: Rp ${t.price.toLocaleString('id-ID')}/pcs
          </span>
        `).join('');
        wBanner.classList.remove('hidden');
      } else {
        wBanner.classList.add('hidden');
      }

      const vContainer = document.getElementById('variantList');
      vContainer.innerHTML = (product.variants || []).map((v, i) => {
        const vStock = v.stock || 0;
        const isReady = vStock > 0;
        return `
          <div onclick="selectVariant(${i})" id="vitem-${i}" class="vitem border ${i === 0 ? 'border-sky-500 bg-sky-500/10' : 'border-slate-800 bg-slate-950'} rounded-xl p-3 flex items-center justify-between cursor-pointer transition-all">
            <div class="flex items-center gap-2">
              <span class="text-xs font-bold text-white">${v.label}</span>
            </div>
            <div class="flex items-center gap-2">
              <span class="text-[10px] font-extrabold px-2 py-0.5 rounded-md ${isReady ? 'bg-emerald-500/10 text-emerald-400 border border-emerald-500/20' : 'bg-rose-500/10 text-rose-400 border border-rose-500/20'}">
                ${isReady ? `Stok: ${vStock} pcs` : '🔴 Habis'}
              </span>
              <span class="text-xs font-black text-sky-400">Rp ${(v.price || 0).toLocaleString('id-ID')}</span>
            </div>
          </div>
        `;
      }).join('');

      updatePaymentCards();
      recalculateSummary();
      document.getElementById('checkoutSheet').classList.remove('hidden');
    }

    function selectVariant(idx) {
      selectedVariantIdx = idx;
      currentQty = 1;
      document.querySelectorAll('.vitem').forEach((el, i) => {
        if(i === idx) {
          el.className = 'vitem border border-sky-500 bg-sky-500/10 rounded-xl p-3 flex items-center justify-between cursor-pointer transition-all';
        } else {
          el.className = 'vitem border border-slate-800 bg-slate-950 rounded-xl p-3 flex items-center justify-between cursor-pointer transition-all';
        }
      });
      recalculateSummary();
    }

    function adjustQty(delta) {
      if (!selectedProduct) return;
      const v = selectedProduct.variants?.[selectedVariantIdx];
      const maxStock = v?.stock ?? 0;

      let newQty = currentQty + delta;
      if (newQty < 1) newQty = 1;
      if (maxStock > 0 && newQty > maxStock) newQty = maxStock;

      currentQty = newQty;
      recalculateSummary();
    }

    function setQuickQty(qty) {
      if (!selectedProduct) return;
      const v = selectedProduct.variants?.[selectedVariantIdx];
      const maxStock = v?.stock ?? 0;

      if (maxStock > 0 && qty > maxStock) qty = maxStock;
      currentQty = qty;
      recalculateSummary();
    }

    function recalculateSummary() {
      if (!selectedProduct) return;
      const variant = selectedProduct.variants?.[selectedVariantIdx];
      if (!variant) return;

      let unitPrice = variant.price || 0;
      const tiers = selectedProduct.wholesaleTiers || [];

      let isWholesaleActive = false;
      if (Array.isArray(tiers) && tiers.length > 0 && currentQty > 1) {
        const sortedTiers = [...tiers].sort((a, b) => b.minQty - a.minQty);
        const matchingTier = sortedTiers.find(t => currentQty >= t.minQty);
        if (matchingTier && matchingTier.price > 0) {
          unitPrice = matchingTier.price;
          isWholesaleActive = true;
        }
      }

      const wholesaleNotice = document.getElementById('wholesaleNotice');
      if (isWholesaleActive) {
        wholesaleNotice.innerText = `✨ Diskon Grosir Aktif! (Rp ${unitPrice.toLocaleString('id-ID')}/pcs)`;
        wholesaleNotice.classList.remove('hidden');
      } else {
        wholesaleNotice.classList.add('hidden');
      }

      document.getElementById('qtyDisplay').innerText = currentQty;
      document.getElementById('summaryUnitPriceText').innerText = 'Rp ' + unitPrice.toLocaleString('id-ID') + (isWholesaleActive ? ' (Grosir)' : '');
      document.getElementById('summaryQtyText').innerText = currentQty + ' pcs';

      const rawSubtotal = unitPrice * currentQty;
      const finalTotal = Math.max(0, rawSubtotal - appliedVoucherDiscount);

      if (appliedVoucherDiscount > 0) {
        document.getElementById('summaryVoucherRow').classList.remove('hidden');
        document.getElementById('summaryVoucherText').innerText = '-Rp ' + appliedVoucherDiscount.toLocaleString('id-ID');
      } else {
        document.getElementById('summaryVoucherRow').classList.add('hidden');
      }

      document.getElementById('summaryTotalText').innerText = 'Rp ' + finalTotal.toLocaleString('id-ID');
    }

    async function applyVoucherWeb() {
      const code = document.getElementById('voucherInput').value.trim();
      if (!code || !selectedProduct) return;

      const variant = selectedProduct.variants?.[selectedVariantIdx];
      let unitPrice = variant?.price || 0;
      const tiers = selectedProduct.wholesaleTiers || [];
      if (Array.isArray(tiers) && tiers.length > 0 && currentQty > 1) {
        const sortedTiers = [...tiers].sort((a, b) => b.minQty - a.minQty);
        const matchingTier = sortedTiers.find(t => currentQty >= t.minQty);
        if (matchingTier && matchingTier.price > 0) unitPrice = matchingTier.price;
      }
      const rawSubtotal = unitPrice * currentQty;

      try {
        const res = await fetch('/api/shop/apply-voucher', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            code,
            totalPrice: rawSubtotal,
            productId: selectedProduct.id,
          }),
        }).then(r => r.json());

        if (res.success && res.data) {
          appliedVoucherCode = res.data.code;
          appliedVoucherDiscount = res.data.discount || 0;
          alert(`🎉 Voucher ${res.data.code} berhasil dipasang! Diskon: Rp ${res.data.discount.toLocaleString('id-ID')}`);
          recalculateSummary();
        } else {
          alert('❌ ' + (res.reason === 'expired' ? 'Voucher telah kadaluwarsa' : (res.reason === 'max_uses' ? 'Voucher sudah habis' : 'Kode voucher tidak valid')));
        }
      } catch (err) {
        alert('❌ Gagal memeriksa voucher');
      }
    }

    function setPaymentMethod(method) {
      paymentMethod = method;
      updatePaymentCards();
    }

    function updatePaymentCards() {
      const qrisBtn = document.getElementById('payCardQRIS');
      const saldoBtn = document.getElementById('payCardSaldo');

      if (paymentMethod === 'qris') {
        qrisBtn.className = 'p-3 bg-slate-950 border border-sky-500 bg-sky-500/10 rounded-xl flex items-center gap-3 text-left transition-all';
        saldoBtn.className = 'p-3 bg-slate-950 border border-slate-800 rounded-xl flex items-center gap-3 text-left transition-all opacity-70';
      } else {
        qrisBtn.className = 'p-3 bg-slate-950 border border-slate-800 rounded-xl flex items-center gap-3 text-left transition-all opacity-70';
        saldoBtn.className = 'p-3 bg-slate-950 border border-sky-500 bg-sky-500/10 rounded-xl flex items-center gap-3 text-left transition-all';
      }
    }

    let activeOrderId = null;
    let pollInterval = null;

    function stopPolling() {
      if (pollInterval) {
        clearInterval(pollInterval);
        pollInterval = null;
      }
    }

    async function submitOrder() {
      if (!selectedProduct) return;

      const variant = selectedProduct.variants?.[selectedVariantIdx];
      const maxStock = variant?.stock ?? 0;
      if (maxStock <= 0) {
        return alert('❌ Stok varian ini sedang habis!');
      }

      let unitPrice = variant?.price || 0;
      const tiers = selectedProduct.wholesaleTiers || [];
      if (Array.isArray(tiers) && tiers.length > 0 && currentQty > 1) {
        const sortedTiers = [...tiers].sort((a, b) => b.minQty - a.minQty);
        const matchingTier = sortedTiers.find(t => currentQty >= t.minQty);
        if (matchingTier && matchingTier.price > 0) unitPrice = matchingTier.price;
      }
      const rawSubtotal = unitPrice * currentQty;
      const finalTotal = Math.max(0, rawSubtotal - appliedVoucherDiscount);

      if (paymentMethod === 'saldo' && userBalance < finalTotal) {
        return alert(`❌ Saldo Bot Anda tidak cukup!\nSaldo: Rp ${userBalance.toLocaleString('id-ID')}\nTagihan: Rp ${finalTotal.toLocaleString('id-ID')}`);
      }

      stopPolling();

      const res = await fetch('/api/shop/create-order', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          telegramUserId: user.id,
          customerName: user.first_name,
          productId: selectedProduct.id,
          variantIndex: selectedVariantIdx,
          quantity: currentQty,
          paymentMethod,
          voucherCode: appliedVoucherDiscount > 0 ? appliedVoucherCode : null,
        }),
      }).then(r => r.json());

      closeSheet();

      if (res.success) {
        activeOrderId = res.orderId;
        if (res.status === 'paid') {
          renderSuccessPaid(res);
        } else {
          renderPendingQRIS(res);
          // Start auto-polling every 3.5 seconds
          pollInterval = setInterval(() => {
            checkPaymentStatus(res.orderId, true);
          }, 3500);
        }
        document.getElementById('resultSheet').classList.remove('hidden');
      } else {
        alert('❌ ' + (res.error || 'Gagal memproses pesanan'));
      }
    }

    function renderPendingQRIS(res) {
      const resultContainer = document.getElementById('resultContent');
      resultContainer.innerHTML = `
        <div class="space-y-3">
          <div class="inline-flex items-center gap-1.5 px-3 py-1 bg-amber-500/10 border border-amber-500/30 rounded-full text-amber-400 text-xs font-bold">
            <span class="w-2 h-2 rounded-full bg-amber-400 animate-ping"></span>
            ⏳ Menunggu Pembayaran
          </div>
          
          <h3 class="text-base font-extrabold text-white">Scan QRIS Pembayaran</h3>
          <p class="text-xs text-slate-400">Total Tagihan: <b class="text-sky-400 text-sm font-mono">Rp ${(res.uniqueAmount || 0).toLocaleString('id-ID')}</b></p>
          
          ${res.qrDataUrl ? `
            <div class="bg-white p-3 rounded-2xl inline-block shadow-2xl shadow-sky-500/10 my-1">
              <img src="${res.qrDataUrl}" class="w-48 h-48 block mx-auto">
            </div>
          ` : ''}

          <p class="text-[11px] text-slate-400 bg-slate-950 p-2.5 rounded-xl border border-slate-800/80">
            📱 Scan QRIS dengan GoPay, OVO, DANA, ShopeePay, atau m-Banking.
          </p>

          <!-- Action Buttons: Cek Pembayaran & Batalkan -->
          <div class="pt-2 space-y-2">
            <button id="btnCheckPayment" onclick="checkPaymentStatus('${res.orderId}', false)" class="w-full py-3 bg-gradient-to-r from-sky-500 to-sky-600 hover:from-sky-400 hover:to-sky-500 text-white font-extrabold text-xs rounded-xl shadow-lg shadow-sky-500/25 transition-all flex items-center justify-center gap-2">
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M21 12a9 9 0 1 1-9-9c2.52 0 4.93 1 6.74 2.74L21 8"/><path d="M21 3v5h-5"/></svg>
              🔄 Cek Pembayaran Now
            </button>
            
            <div class="grid grid-cols-2 gap-2 pt-1">
              <button onclick="cancelOrderWeb('${res.orderId}')" class="py-2.5 bg-rose-500/10 hover:bg-rose-500/20 text-rose-400 border border-rose-500/30 font-bold text-xs rounded-xl transition-all flex items-center justify-center gap-1.5">
                <svg class="w-3.5 h-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><circle cx="12" cy="12" r="10"/><path d="m15 9-6 6"/><path d="m9 9 6 6"/></svg>
                Batalkan Pesanan
              </button>

              <button onclick="closeResultSheetOnly()" class="py-2.5 bg-slate-800 hover:bg-slate-700 text-slate-300 font-semibold text-xs rounded-xl transition-all">
                Kembali ke Catalog
              </button>
            </div>
          </div>
        </div>
      `;
    }

    function renderSuccessPaid(res) {
      stopPolling();
      const resultContainer = document.getElementById('resultContent');
      resultContainer.innerHTML = `
        <div class="space-y-3 py-2">
          <div class="w-14 h-14 rounded-full bg-emerald-500/20 border border-emerald-500/40 text-emerald-400 flex items-center justify-center mx-auto shadow-lg shadow-emerald-500/20">
            <svg class="w-8 h-8" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3"><path d="M20 6 9 17l-5-5"/></svg>
          </div>
          <h3 class="text-lg font-extrabold text-emerald-400">Pembayaran Berhasil!</h3>
          <div class="bg-slate-950 border border-slate-800 p-3 rounded-2xl text-xs space-y-1">
            <div class="text-slate-400">Order ID: <code class="text-white font-bold">${res.orderId}</code></div>
            <div class="text-sky-400 font-extrabold">Status: LUNAS (Paid)</div>
          </div>
          <p class="text-xs text-slate-300">📦 Detail produk digital &amp; Nota PNG telah dikirimkan otomatis ke Telegram chat Anda.</p>
          <button onclick="closeResultSheetOnly()" class="w-full py-3 bg-sky-500 hover:bg-sky-400 text-white font-extrabold text-xs rounded-xl shadow-lg transition-all">
            Kembali Belanja
          </button>
        </div>
      `;
    }

    async function checkPaymentStatus(orderId, isSilent = false) {
      if (!orderId) return;
      try {
        const res = await fetch(`/api/shop/order-status/${orderId}`).then(r => r.json());
        if (res.success && res.data) {
          const order = res.data;
          if (order.status === 'paid' || order.status === 'success') {
            renderSuccessPaid({ orderId, ...order });
            initApp(); // refresh user balance & catalog
          } else if (!isSilent) {
            alert('⏳ Pembayaran belum terdeteksi. Silakan selesaikan pembayaran QRIS terlebih dahulu.');
          }
        } else if (!isSilent) {
          alert('❌ Gagal memeriksa status pembayaran.');
        }
      } catch (err) {
        if (!isSilent) alert('❌ Gagal terhubung ke server.');
      }
    }

    async function cancelOrderWeb(orderId) {
      if (!orderId) return;
      if (!confirm('Apakah Anda yakin ingin membatalkan pesanan QRIS ini?')) return;

      try {
        const res = await fetch('/api/shop/cancel-order', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ orderId }),
        }).then(r => r.json());

        stopPolling();
        closeResultSheetOnly();

        if (res.success) {
          alert('🗑️ Pesanan berhasil dibatalkan.');
        } else {
          alert('❌ ' + (res.error || 'Gagal membatalkan pesanan'));
        }
      } catch (err) {
        alert('❌ Error: ' + err.message);
      }
    }

    function closeSheet() {
      document.getElementById('checkoutSheet').classList.add('hidden');
    }

    function closeResultSheetOnly() {
      stopPolling();
      document.getElementById('resultSheet').classList.add('hidden');
    }

    function closeResultSheet() {
      stopPolling();
      document.getElementById('resultSheet').classList.add('hidden');
      if(tg) tg.close();
    }

    initApp();
  </script>
</body>
</html>
